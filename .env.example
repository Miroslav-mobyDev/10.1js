# Конфигурация Telegram бота для марафона восточной кухни

# Токен вашего бота (получите у @BotFather в Telegram)
BOT_TOKEN=your_actual_bot_token_here

# ID администратора (ваш Telegram ID)
# Чтобы узнать свой ID, напишите @userinfobot в Telegram
ADMIN_ID=your_telegram_id_here

# Ссылка на WhatsApp группу марафона
WHATSAPP_GROUP_LINK=https://chat.whatsapp.com/your-real-group-link

# Пример заполненного файла:
# BOT_TOKEN=1234567890:AAGKj-abc123def456ghi789jkl012mno345p
# ADMIN_ID=987654321
# WHATSAPP_GROUP_LINK=https://chat.whatsapp.com/BBGGhhii112233aabbccdd